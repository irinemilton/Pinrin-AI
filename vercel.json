{
  "version": 2,
  "builds": [
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/static/index.html" },
    { "src": "/about", "dest": "/static/about.html" },
    { "src": "/contact", "dest": "/static/contact.html" },
    { "src": "/cookie-policy", "dest": "/static/cookie-policy.html" },
    { "src": "/static/(.*)", "dest": "/static/$1" }
  ]
}
