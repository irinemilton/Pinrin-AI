# =============================================================================
# PinPilot Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Dropbox ---
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token
DROPBOX_PRODUCTS_PATH=/PinPilot/products
DROPBOX_PUBLISHED_PATH=/PinPilot/published

# --- Pinterest ---
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_BOARD_ID=your_default_board_id
# Use sandbox API for testing (set to "true" for testing, "false" for production)
PINTEREST_SANDBOX=true

# --- Gumroad ---
# Your default Gumroad store URL (individual product URLs go in product.json)
GUMROAD_STORE_URL=https://yourname.gumroad.com
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_optional

# --- Publishing Settings ---
# Maximum pins to publish per run
MAX_PINS_PER_RUN=10
# Delay between pin publications (seconds) to avoid rate limits
PIN_PUBLISH_DELAY=30
# Hours between scheduled runs
SCHEDULE_INTERVAL_HOURS=6

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=pinpilot.log

# --- Autonomous agent workflow ---
# The UI starts runs; the goal and artifacts are configured server-side.
HUGGINGFACE_API_TOKEN=hf_replace_with_a_server_side_token
HUGGINGFACE_TEXT_MODEL=Qwen/Qwen2.5-72B-Instruct
# Select "huggingface" or "novita" for agent reasoning
AGENT_LLM_PROVIDER=huggingface
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/v3/openai
NOVITA_TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional per-agent overrides; blank uses HUGGINGFACE_TEXT_MODEL
AGENT_TREND_MODEL=
AGENT_OPPORTUNITY_MODEL=
AGENT_PRODUCT_MODEL=
AGENT_MARKETING_MODEL=
AGENT_PERFORMANCE_MODEL=
AGENT_CAMPAIGN_GOAL=Create a digital product for the configured audience and prepare marketing Pins.
AGENT_PRODUCT_FILE=
AGENT_PIN_IMAGES=
AGENT_BOARD_NAME=
AGENT_PRODUCT_TITLE=
AGENT_PRICE=0
PINTEREST_TRENDS_JSON=
PINTEREST_TRENDS_URL=
PINTEREST_TRENDS_REGION=US
PINTEREST_TRENDS_TYPE=growing
PINTEREST_TRENDS_LIMIT=50
AGENT_SCHEDULE_INTERVAL_HOURS=24
AGENT_MAX_RETRIES=2
# Image generation through the public Hugging Face Gradio MCP Space
IMAGE_PROVIDER_MCP_URL=https://guaryn-qwen-image-2-1-uncensored-aio-loras.hf.space/gradio_api/mcp/
IMAGE_ASPECT_RATIO=Portrait · 3:4 (864x1152)
IMAGE_STEPS=6
# Optional per-agent creative prompt controls
AGENT_CREATIVE_DIRECTION=Make each run feel distinct: choose a fresh visual world and avoid generic template aesthetics.
AGENT_OPPORTUNITY_INSTRUCTIONS=Find differentiated opportunities, not copies of the trend.
AGENT_PRODUCT_INSTRUCTIONS=Build a useful, coherent product concept with a clear promise and original theme.
AGENT_MARKETING_INSTRUCTIONS=Create varied Pinterest-ready concepts with strong hooks and specific visual directions.
AGENT_IMAGE_INSTRUCTIONS=Create a distinctive editorial visual system with a strong focal point and clean space for text overlay.
PINRIN_API_KEY=replace_with_server_api_key
FRONTEND_ORIGINS=https://your-project.vercel.app,http://localhost:8000
